---
import { instagramUrl } from '../data/site';
import LiquidHeader from './liquid-glass/LiquidHeader';
import '../styles/liquid-glass.css';
---

<LiquidHeader instagramUrl={instagramUrl} client:load />

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
    border-bottom: 1px solid rgba(255, 255, 255, 0.8);
    background: rgba(250, 252, 252, 0.74);
    -webkit-backdrop-filter: blur(6px) saturate(1.2);
    backdrop-filter: blur(6px) saturate(1.2);
    box-shadow: inset 0 -1px 0 rgba(20, 70, 120, 0.08);
    transition: background-color 240ms ease, box-shadow 240ms ease;
  }

  .header-shell {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 46px;
    align-items: center;
    width: min(calc(100% - 64px), 1440px);
    min-height: 104px;
    margin-inline: auto;
    transition: min-height 240ms ease;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-decoration: none;
  }

  .brand-logo {
    width: 90px;
    height: 90px;
    object-fit: contain;
    transition: width 240ms ease, height 240ms ease;
  }

  .desktop-nav {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-self: start;
  }

  .desktop-nav a {
    color: var(--ink);
    font-size: 0.87rem;
    font-weight: 650;
    text-decoration: none;
  }

  .desktop-nav a:hover {
    color: var(--navy);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
  }

  .instagram-link {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--navy);
    background: rgba(255, 255, 255, 0.72);
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .instagram-link:hover {
    border-color: #bad5df;
    background: var(--white);
    transform: translateY(-2px);
  }

  .instagram-link svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .instagram-link .instagram-dot {
    fill: currentColor;
    stroke: none;
  }

  .header-cta {
    justify-self: end;
    min-height: 44px;
    padding: 12px 18px;
    font-size: 0.82rem;
  }

  .menu-button,
  .mobile-menu {
    display: none;
  }

  @media (min-width: 1021px) {
    .site-header.is-compact {
      background: rgba(250, 252, 252, 0.74);
      box-shadow: 0 10px 32px rgba(17, 33, 46, 0.08);
    }

    .site-header.is-compact .header-shell {
      min-height: 86px;
    }

    .site-header.is-compact .brand-logo {
      width: 72px;
      height: 72px;
    }
  }

  @media (max-width: 1020px) {
    .header-shell {
      grid-template-columns: 1fr auto;
      min-height: 88px;
    }

    .brand-logo {
      width: 68px;
      height: 68px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .menu-button {
      display: grid;
      gap: 4px;
      width: 44px;
      height: 44px;
      place-content: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      background-color: var(--white);
      cursor: pointer;
    }

    .menu-button span:not(.sr-only) {
      width: 18px;
      height: 2px;
      background: var(--ink);
    }

    .mobile-menu {
      position: absolute;
      z-index: 1;
      top: 100%;
      right: 0;
      left: 0;
      display: block;
      height: calc(100vh - 88px);
      height: calc(100dvh - 88px);
      padding: 34px 32px;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-top: 1px solid var(--line);
      background: #fafcfc;
      box-shadow: 0 24px 60px rgba(17, 33, 46, 0.14);
      -webkit-overflow-scrolling: touch;
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .site-header:has(.mobile-menu:not([hidden])) {
      background: #fafcfc;
    }

    .mobile-menu nav {
      display: grid;
      gap: 24px;
      width: min(100%, 720px);
      margin-inline: auto;
    }

    .mobile-menu nav > a:not(.button) {
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
      font-size: 1.25rem;
      font-weight: 650;
      text-decoration: none;
    }
  }

  @media (max-width: 640px) {
    .header-shell {
      width: calc(100% - 32px);
    }

    .brand-logo {
      width: 64px;
      height: 64px;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-header.is-compact {
      background: #fafcfc;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
