---
import { instagramUrl } from '../data/site';

const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#results', label: 'Our Work' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/about/', label: 'About' },
];

const showInstagram = Boolean(instagramUrl);
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="Sparkclean home">
      <img class="brand-logo" src="/images/sparkclean-logo.png" alt="" width="640" height="640" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="header-actions">
      {showInstagram && (
        <a class="instagram-link" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Visit Sparkclean on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4.25"></circle>
            <circle class="instagram-dot" cx="17.4" cy="6.7" r="1"></circle>
          </svg>
        </a>
      )}
      <a class="button button-primary header-cta" href="/contact/">Request a Quote</a>
    </div>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Open menu</span>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {showInstagram && <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>}
      <a href="tel:+19258341815">Call (925) 834-1815</a>
      <a class="button button-primary" href="/contact/">Request a Quote</a>
    </nav>
  </div>
</header>

<script>
  const siteHeader = document.querySelector('.site-header');
  const menuButton = document.querySelector('.menu-button');
  const mobileMenu = document.querySelector('#mobile-menu');

  const updateHeaderSize = () => {
    siteHeader?.classList.toggle('is-compact', window.scrollY > 40);
  };

  updateHeaderSize();
  window.addEventListener('scroll', updateHeaderSize, { passive: true });

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = isOpen;
    document.body.classList.toggle('menu-open', !isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      if (mobileMenu instanceof HTMLElement) mobileMenu.hidden = true;
      document.body.classList.remove('menu-open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
    border-bottom: 1px solid rgba(220, 231, 235, 0.85);
    background: rgba(250, 252, 252, 0.9);
    backdrop-filter: blur(18px);
    transition: background-color 240ms ease, box-shadow 240ms ease;
  }

  .header-shell {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 46px;
    align-items: center;
    width: min(calc(100% - 64px), 1440px);
    min-height: 104px;
    margin-inline: auto;
    transition: min-height 240ms ease;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-decoration: none;
  }

  .brand-logo {
    width: 90px;
    height: 90px;
    object-fit: contain;
    transition: width 240ms ease, height 240ms ease;
  }

  .desktop-nav {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-self: start;
  }

  .desktop-nav a {
    color: var(--ink);
    font-size: 0.87rem;
    font-weight: 650;
    text-decoration: none;
  }

  .desktop-nav a:hover {
    color: var(--navy);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
  }

  .instagram-link {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--navy);
    background: rgba(255, 255, 255, 0.72);
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .instagram-link:hover {
    border-color: #bad5df;
    background: var(--white);
    transform: translateY(-2px);
  }

  .instagram-link svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .instagram-link .instagram-dot {
    fill: currentColor;
    stroke: none;
  }

  .header-cta {
    justify-self: end;
    min-height: 44px;
    padding: 12px 18px;
    font-size: 0.82rem;
  }

  .menu-button,
  .mobile-menu {
    display: none;
  }

  @media (min-width: 1021px) {
    .site-header.is-compact {
      background: rgba(250, 252, 252, 0.96);
      box-shadow: 0 10px 32px rgba(17, 33, 46, 0.08);
    }

    .site-header.is-compact .header-shell {
      min-height: 86px;
    }

    .site-header.is-compact .brand-logo {
      width: 72px;
      height: 72px;
    }
  }

  @media (max-width: 1020px) {
    .header-shell {
      grid-template-columns: 1fr auto;
      min-height: 88px;
    }

    .brand-logo {
      width: 68px;
      height: 68px;
    }

    .desktop-nav,
    .header-actions {
      display: none;
    }

    .menu-button {
      display: grid;
      gap: 4px;
      width: 44px;
      height: 44px;
      place-content: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--white);
      cursor: pointer;
    }

    .menu-button span:not(.sr-only) {
      width: 18px;
      height: 2px;
      background: var(--ink);
    }

    .mobile-menu {
      position: absolute;
      z-index: 1;
      top: 100%;
      right: 0;
      left: 0;
      display: block;
      height: calc(100vh - 88px);
      height: calc(100dvh - 88px);
      padding: 34px 32px;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-top: 1px solid var(--line);
      background: #fafcfc;
      box-shadow: 0 24px 60px rgba(17, 33, 46, 0.14);
      -webkit-overflow-scrolling: touch;
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .mobile-menu nav {
      display: grid;
      gap: 24px;
      width: min(100%, 720px);
      margin-inline: auto;
    }

    .mobile-menu nav > a:not(.button) {
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
      font-size: 1.25rem;
      font-weight: 650;
      text-decoration: none;
    }
  }

  @media (max-width: 640px) {
    .header-shell {
      width: calc(100% - 32px);
    }

    .brand-logo {
      width: 64px;
      height: 64px;
    }
  }
</style>
