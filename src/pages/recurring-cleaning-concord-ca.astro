---
import { areaServedSchema, goodToKnowFaqs } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGlassActions from '../components/liquid-glass/HeroGlassActions';
import GlassAction from '../components/liquid-glass/GlassAction';

const faqs = [
  {
    question: 'How often can recurring cleaning be scheduled?',
    answer:
      'Scheduling depends on your home and current availability. Contact Sparkclean to discuss the frequency that best fits your household and cleaning priorities.',
  },
  {
    question: 'Will every visit follow the same priorities?',
    answer:
      'We begin with an agreed routine for the main areas of your home. You can also communicate changing priorities when a particular room needs extra attention.',
  },
  {
    question: 'Should I begin with a deep cleaning?',
    answer:
      'If the home has heavier buildup or has not been professionally cleaned recently, a deep cleaning may provide a stronger starting point before recurring upkeep.',
  },
  {
    question: 'How do I request a quote?',
    answer:
      'Call (925) 834-1815 or visit our Contact page to prepare an email request. Include your city, approximate home size, preferred schedule, and cleaning priorities.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Recurring House Cleaning in Concord, CA',
  description:
    'Recurring residential cleaning for Concord-area homes, including kitchens, bathrooms, floors, bedrooms, and everyday living spaces.',
  serviceType: 'Recurring house cleaning',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Sparkclean Cleaning Services',
    telephone: '+1-925-834-1815',
  },
  areaServed: areaServedSchema,
};
---

<BaseLayout
  title="Recurring House Cleaning in Concord, CA | Sparkclean"
  description="Recurring house cleaning in Concord and the East Bay. Regular care for kitchens, bathrooms, floors, and living areas. Request a Sparkclean quote."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="service-hero">
    <div class="shell service-hero-grid">
      <div class="service-hero-copy reveal">
        <h1 class="display-title">Recurring House Cleaning in Concord, CA</h1>
        <p class="lead">
          Come home to clean without spending your free time catching up. Scheduled visits keep kitchens, bathrooms, floors, and everyday living spaces cared for.
        </p>

        <div class="service-actions">
          <HeroGlassActions quoteHref="/contact/" client:load />
        </div>

        <div class="service-proof" aria-label="Service highlights">
          <span>Flexible scheduling</span>
          <span>Consistent home care</span>
          <span>Concord &amp; the East Bay</span>
        </div>
      </div>

      <div class="service-visual reveal">
        <!-- Photo slot: replace with an owner-supplied recurring-cleaning photo (add alt text then). -->
        <div class="photo-placeholder" aria-hidden="true"></div>
        <div class="photo-note sc-frosted-note">
          <span>Everyday upkeep</span>
          <strong>A calmer home starts with a reliable routine.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="service-intro">
    <div class="shell intro-grid reveal">
      <div>
        <h2 class="section-title">Regular Cleaning That Fits Your Home</h2>
      </div>
      <div class="intro-copy">
        <p>Regular visits help keep dust, fingerprints, crumbs, and bathroom buildup under control, so cleaning does not keep falling to the bottom of your list.</p>
        <p>We agree on a routine based on your home, preferred frequency, and the rooms that need the most attention.</p>
      </div>
    </div>
  </section>

  <section class="included">
    <div class="shell">
      <div class="section-heading reveal">
        <div>
          <h2 class="section-title">What Recurring Cleaning Includes</h2>
        </div>
        <p>These are typical areas covered during regular visits. We confirm the tasks and priorities for your home before service begins.</p>
      </div>

      <div class="room-grid">
        <article class="room-card reveal">
          <h3>Kitchen</h3>
          <ul>
            <li>Countertops and accessible surfaces</li>
            <li>Sink and faucet</li>
            <li>Stovetop and appliance exteriors</li>
            <li>Cabinet fronts as needed</li>
            <li>Vacuumed and mopped floors</li>
          </ul>
        </article>

        <article class="room-card room-card-featured reveal">
          <h3>Bathrooms</h3>
          <ul>
            <li>Toilets, sinks, and faucets</li>
            <li>Mirrors and counters</li>
            <li>Tub and shower surfaces</li>
            <li>High-touch fixtures</li>
            <li>Vacuumed and mopped floors</li>
          </ul>
        </article>

        <article class="room-card reveal">
          <h3>Bedrooms &amp; Living Areas</h3>
          <ul>
            <li>Dusting accessible surfaces</li>
            <li>Vacuuming rugs and floors</li>
            <li>Mopping hard flooring</li>
            <li>Bedroom surface care</li>
            <li>A neat, refreshed finish</li>
          </ul>
        </article>
      </div>

      <p class="scope-note reveal">Does your home need extra attention first? Start with a <a href="/deep-cleaning-concord-ca/">deep cleaning</a> before regular upkeep.</p>
    </div>
  </section>

  <section class="service-process">
    <div class="shell">
      <div class="section-heading section-heading-light reveal">
        <div>
          <h2 class="section-title">How to Start Recurring Cleaning</h2>
        </div>
        <p>We’ll discuss your home, confirm the cleaning tasks, and check schedule availability.</p>
      </div>

      <div class="process-grid">
        <article class="reveal">
          <span>01</span>
          <h3>Tell us what you need</h3>
          <p>Share the size of your home, the rooms you want cleaned, and the areas that matter most.</p>
        </article>
        <article class="reveal">
          <span>02</span>
          <h3>Choose your routine</h3>
          <p>We help establish a recurring schedule that fits your household and cleaning priorities.</p>
        </article>
        <article class="reveal">
          <span>03</span>
          <h3>Keep the cleaning on track</h3>
          <p>Sparkclean returns on schedule and follows the agreed priorities for consistent care.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="fit">
    <div class="shell fit-grid">
      <div class="fit-copy reveal">
        <h2 class="section-title">Is Recurring Cleaning Right for You?</h2>
        <p>A practical choice when your schedule is full, cleaning keeps piling up, or you simply want more time for yourself.</p>

        <div class="fit-list">
          <div><span aria-hidden="true">✓</span><p>Busy households balancing work, school, and home</p></div>
          <div><span aria-hidden="true">✓</span><p>Kitchens and bathrooms that need consistent care</p></div>
          <div><span aria-hidden="true">✓</span><p>Regular upkeep instead of occasional major catch-ups</p></div>
        </div>
      </div>

      <div class="fit-visual reveal">
        <div class="fit-stat">
          <strong>More consistency.</strong>
          <span>Less time spent catching up.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="local-service">
    <div class="shell local-grid reveal">
      <div>
        <h2 class="section-title">Recurring Cleaning Across the East Bay</h2>
      </div>
      <div>
        <p>Sparkclean is Concord-based and provides residential cleaning throughout nearby communities, including Pleasant Hill, Martinez, Walnut Creek, Lafayette, Moraga, and Orinda.</p>
        <a class="text-link" href="/service-areas/">Explore our service areas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="service-faq">
    <div class="shell faq-grid">
      <div class="faq-intro reveal">
        <h2 class="section-title">Recurring Cleaning FAQs</h2>
        <p>Still have questions? Call <a href="tel:+19258341815">(925) 834-1815</a>.</p>
      </div>

      <div class="faq-list reveal">
        {[...faqs, goodToKnowFaqs[0]].map((faq, index) => (
          <details open={index === 0}>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="service-cta">
    <div class="shell cta-card reveal">
      <div>
        <h2 class="section-title">Request a Recurring Cleaning Quote</h2>
      </div>
      <div class="cta-actions">
        <GlassAction href="/contact/" label="Request a Quote" variant="light" client:visible />
        <a class="call-link" href="tel:+19258341815">Call (925) 834-1815</a>
        <span>Monday–Saturday · 9:00 AM–4:00 PM</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    padding: 92px 0 110px;
    background: linear-gradient(115deg, #ffffff 0%, #f8fcfd 58%, #e5f4f8 100%);
  }

  .service-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 90px;
    align-items: center;
  }

  .service-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .service-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 34px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .service-proof span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .service-proof span::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    content: '';
  }

  .service-visual {
    position: relative;
  }

  .photo-placeholder {
    display: flex;
    min-height: 650px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 36px;
    background: linear-gradient(145deg, #eaf6f9 0%, #cce7ef 55%, #acd4e1 100%);
    box-shadow: var(--shadow);
  }

  .photo-placeholder span,
  .photo-placeholder strong {
    display: block;
    text-align: center;
  }

  .photo-placeholder span {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .photo-placeholder strong {
    max-width: 270px;
    margin-top: 12px;
    color: var(--navy);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .photo-note {
    position: absolute;
    right: -24px;
    bottom: 42px;
    display: grid;
    max-width: 270px;
    gap: 9px;
    padding: 22px 24px;
    border-radius: 20px;
    background: var(--sc-note-surface, rgba(250, 252, 252, 0.96));
    box-shadow: 0 18px 45px rgba(17, 33, 46, 0.14);
  }

  .photo-note span {
    color: var(--sc-note-ink, var(--blue));
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .photo-note strong {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .service-intro,
  .included,
  .fit,
  .local-service,
  .service-faq {
    padding: 112px 0;
  }

  .intro-grid,
  .local-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: 100px;
    align-items: start;
  }

  .intro-copy,
  .local-grid > div:last-child > p {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .intro-copy p {
    margin: 0 0 22px;
  }

  .included {
    background: #f4f9fa;
  }

  .room-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  .room-card {
    min-height: 430px;
    padding: 34px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--paper);
  }

  .room-card-featured {
    color: white;
    border-color: var(--navy);
    background: var(--navy);
    box-shadow: 0 24px 55px rgba(20, 70, 120, 0.18);
    transform: translateY(-12px);
  }

  .card-number {
    margin: 0 0 76px;
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .room-card h3 {
    margin: 0 0 24px;
    font-size: 1.9rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .room-card ul {
    display: grid;
    gap: 13px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .room-card li {
    position: relative;
    padding-left: 19px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .room-card li::before {
    position: absolute;
    top: 8px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    content: '';
  }

  .room-card-featured li {
    color: rgba(255, 255, 255, 0.78);
  }

  .scope-note {
    margin: 34px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .scope-note a,
  .faq-intro a {
    color: var(--navy);
    font-weight: 750;
  }

  .service-process {
    padding: 112px 0;
    color: white;
    background: var(--ink);
  }

  .section-heading-light .section-title,
  .section-heading-light > p {
    color: white;
  }

  .section-heading-light .eyebrow {
    color: #8cc9dc;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 52px;
  }

  .process-grid article {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .process-grid span {
    color: #8cc9dc;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .process-grid h3 {
    margin: 38px 0 18px;
    color: white;
    font-size: 1.55rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .process-grid p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.8fr);
    gap: 100px;
    align-items: center;
  }

  .fit-copy > p:not(.eyebrow) {
    max-width: 680px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .fit-list {
    display: grid;
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }

  .fit-list div {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .fit-list span {
    padding-top: 3px;
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .fit-list p {
    margin: 0;
    line-height: 1.55;
  }

  .fit-visual {
    display: flex;
    min-height: 600px;
    align-items: flex-end;
    padding: 34px;
    border-radius: 32px;
    background: linear-gradient(145deg, #dff1f5 0%, #b9dce6 55%, #8fc4d5 100%);
  }

  .fit-stat {
    display: grid;
    width: 100%;
    gap: 8px;
    padding: 26px;
    border-radius: 22px;
    background: rgba(250, 252, 252, 0.94);
    box-shadow: 0 18px 45px rgba(17, 33, 46, 0.12);
  }

  .fit-stat strong {
    color: var(--navy);
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .fit-stat span {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .local-service {
    background: var(--pale);
  }

  .local-grid > div:last-child > p {
    margin: 0 0 28px;
  }

  .text-link {
    color: var(--navy);
    font-size: 0.94rem;
    font-weight: 750;
    text-decoration: none;
  }

  .text-link span {
    display: inline-block;
    margin-left: 6px;
    transition: transform 180ms ease;
  }

  .text-link:hover span {
    transform: translateX(4px);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1fr);
    gap: 110px;
    align-items: start;
  }

  .faq-intro {
    position: sticky;
    top: 110px;
  }

  .faq-intro > p:not(.eyebrow) {
    margin: 28px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq-list details {
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }

  .faq-list summary {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.4;
    cursor: pointer;
  }

  .faq-list details p {
    max-width: 720px;
    margin: 18px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .service-cta {
    padding: 28px 0 112px;
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.55fr);
    gap: 70px;
    align-items: center;
    padding: 68px;
    border-radius: 32px;
    color: white;
    background: var(--navy);
    box-shadow: 0 28px 70px rgba(20, 70, 120, 0.2);
  }

  .cta-card .eyebrow {
    color: #8cc9dc;
  }

  .cta-card .section-title {
    color: white;
  }

  .cta-actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .button-white {
    color: var(--navy);
    background: white;
  }

  .call-link {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .cta-actions span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
  }

  @media (max-width: 991px) {
    .service-hero-grid,
    .intro-grid,
    .local-grid,
    .faq-grid,
    .fit-grid {
      grid-template-columns: 1fr;
    }

    .service-hero-grid,
    .fit-grid {
      gap: 62px;
    }

    .service-hero-copy {
      max-width: 780px;
    }

    .photo-placeholder {
      min-height: 560px;
    }

    .intro-grid,
    .local-grid,
    .faq-grid {
      gap: 46px;
    }

    .room-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .room-card {
      min-height: auto;
    }

    .room-card-featured {
      transform: none;
    }

    .card-number {
      margin-bottom: 42px;
    }

    .fit-visual {
      min-height: 520px;
    }

    .faq-intro {
      position: static;
    }

    .cta-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .service-hero {
      padding: 62px 0 78px;
    }

    .service-actions {
      flex-direction: column;
    }

    .service-proof {
      display: grid;
    }

    .photo-placeholder {
      min-height: 430px;
      border-radius: 26px;
    }

    .photo-note {
      position: static;
      max-width: none;
      margin-top: 14px;
    }

    .service-intro,
    .included,
    .service-process,
    .fit,
    .local-service,
    .service-faq {
      padding: 78px 0;
    }

    .room-card {
      padding: 28px;
      border-radius: 22px;
    }

    .process-grid {
      gap: 40px;
    }

    .fit-visual {
      min-height: 430px;
      padding: 20px;
      border-radius: 26px;
    }

    .fit-list div {
      grid-template-columns: 34px 1fr;
      gap: 10px;
    }

    .faq-list summary {
      font-size: 1.08rem;
    }

    .service-cta {
      padding: 16px 0 78px;
    }

    .cta-card {
      gap: 42px;
      padding: 42px 26px;
      border-radius: 26px;
    }

    .cta-actions,
    .cta-actions .button {
      width: 100%;
    }
  }
</style>
