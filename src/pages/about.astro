---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGlassActions from '../components/liquid-glass/HeroGlassActions';
import GlassAction from '../components/liquid-glass/GlassAction';
import { instagramUrl, foundingYear } from '../data/site';

const principles = [
  {
    title: 'Attention to detail',
    copy: 'From high-touch surfaces to easy-to-miss edges, we pay attention to the details that help a home feel clean.',
  },
  {
    title: 'Your priorities matter',
    copy: 'Every household is different. We discuss what needs attention so the cleaning fits your home and routine.',
  },
  {
    title: 'Dependable service',
    copy: 'Clear communication, punctuality, and consistent work are what keep customers returning.',
  },
];

const reviews = [
  {
    quote: 'They pay attention to detail, do a great job, and are always on time.',
    attribution: 'Long-term Sparkclean customer',
  },
  {
    quote: 'They use high-quality products, are thorough in the cleaning, and adapt to you as a client.',
    attribution: 'Long-term Sparkclean customer',
  },
  {
    quote: 'The details—from baseboards to fixtures—made the home feel refreshed.',
    attribution: 'Concord-area customer',
  },
];
---

<BaseLayout
  title="About Sparkclean Cleaning Services | Concord, CA"
  description="Meet Adan and Sparkclean, a family-run Concord house cleaning service since 2021. Bonded and insured, with a background-checked team serving the East Bay."
>
  <section class="about-hero">
    <div class="shell about-hero-grid">
      <div class="about-hero-copy reveal">
        <h1 class="display-title">About Sparkclean</h1>
        <p class="lead">Family-run home cleaning in Concord since 2021. We focus on thorough work, dependable service, and the details that matter to each household.</p>
        <div class="hero-actions">
          <HeroGlassActions quoteHref="/contact/" client:load />
        </div>
      </div>

      <div class="about-visual reveal" aria-label="Sparkclean service values">
        <div class="value-chip value-chip-one sc-frosted-note">Thorough</div>
        <div class="value-chip value-chip-two sc-frosted-note">Adaptable</div>
        <div class="value-chip value-chip-three sc-frosted-note">Dependable</div>
        <div class="visual-message">
          <span>Local residential care</span>
          <strong>Concord-based service with attention in every room.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="about-intro">
    <div class="shell intro-grid reveal">
      <div>
        <h2 class="section-title">Cleaning That Starts With You</h2>
      </div>
      <div class="intro-copy">
        <p>We start with a conversation about your home, schedule, and the areas you want us to focus on.</p>
        <p>Whether you need regular upkeep, deep cleaning, help during a move, or cleaning after a remodel, the goal is the same: a home that feels better to come back to.</p>
      </div>
    </div>
  </section>

  <section class="about-owner" aria-labelledby="owner-title">
    <div class="shell intro-grid reveal">
      <div>
        <h2 class="section-title" id="owner-title">Meet Adan</h2>
        <picture>
          <source
            type="image/webp"
            srcset="/images/adan-sparkclean-owner-640.webp 640w, /images/adan-sparkclean-owner.webp 1024w"
            sizes="(max-width: 860px) calc(100vw - 32px), 420px"
          />
          <img
            class="owner-photo"
            src="/images/adan-sparkclean-owner-640.jpg"
            srcset="/images/adan-sparkclean-owner-640.jpg 640w, /images/adan-sparkclean-owner.jpg 1024w"
            sizes="(max-width: 860px) calc(100vw - 32px), 420px"
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
            alt="Adan, owner of Sparkclean Cleaning Services"
          />
        </picture>
      </div>
      <div class="intro-copy">
        <p>Sparkclean started in {foundingYear} as a family business, founded by Adan’s mom. Today Adan owns and runs it. He’s the person behind the work and the face of the business.</p>
        <p>Adan leads a team of cleaners, and everyone on the team goes through a background check. Sparkclean is bonded and insured.</p>
        <p>
          On Instagram, Adan shares videos of how he cleans, so you can see the care that goes into a Sparkclean visit before you book.
          {instagramUrl && <> <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Watch on Instagram <span aria-hidden="true">↗</span></a></>}
        </p>
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="shell">
      <div class="section-heading reveal">
        <div>
          <h2 class="section-title">What You Can Expect</h2>
        </div>
        <p>Good service comes down to the work we do and how we care for your home.</p>
      </div>

      <div class="principle-grid">
        {principles.map((principle, index) => (
          <article class:list={['principle-card', { featured: index === 1 }, 'reveal']}>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="customer-proof">
    <div class="shell proof-grid">
      <div class="proof-intro reveal">
        <h2 class="section-title">What Our Customers Say</h2>
        <p>Customers describe thorough work, punctual visits, and cleaning that adapts to their needs.</p>
      </div>

      <div class="review-stack">
        {reviews.map((review) => (
          <blockquote class="review-item reveal">
            <p>“{review.quote}”</p>
            <footer>{review.attribution} · Google review</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="approach">
    <div class="shell">
      <div class="section-heading section-heading-light reveal">
        <div>
          <h2 class="section-title">How We Work</h2>
        </div>
        <p>We agree on the cleaning details before your visit, so you know what to expect.</p>
      </div>

      <div class="approach-grid">
        <article class="reveal">
          <span>01</span>
          <h3>Listen first</h3>
          <p>We begin with the home, requested service, schedule, and areas that need the most attention.</p>
        </article>
        <article class="reveal">
          <span>02</span>
          <h3>Agree on the details</h3>
          <p>We confirm the rooms, tasks, and any detailed requests before your appointment.</p>
        </article>
        <article class="reveal">
          <span>03</span>
          <h3>Care for the details</h3>
          <p>We clean the agreed areas with the attention our returning customers value.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-services">
    <div class="shell services-grid">
      <div class="reveal">
        <h2 class="section-title">Our Cleaning Services</h2>
      </div>
      <div class="service-links reveal">
        <a href="/recurring-cleaning-concord-ca/"><span aria-hidden="true">•</span><strong>Recurring Cleaning</strong><i>→</i></a>
        <a href="/deep-cleaning-concord-ca/"><span aria-hidden="true">•</span><strong>Deep Cleaning</strong><i>→</i></a>
        <a href="/move-in-move-out-cleaning-concord-ca/"><span aria-hidden="true">•</span><strong>Move-In &amp; Move-Out Cleaning</strong><i>→</i></a>
        <a href="/post-construction-cleaning-concord-ca/"><span aria-hidden="true">•</span><strong>Post-Construction Cleaning</strong><i>→</i></a>
      </div>
    </div>
  </section>

  <section class="about-local">
    <div class="shell local-card reveal">
      <div>
        <h2 class="section-title">Concord-Based. Serving the East Bay.</h2>
      </div>
      <div>
        <p>Sparkclean is based in Concord and serves nearby communities including Pleasant Hill, Martinez, Walnut Creek, Lafayette, Moraga, and Orinda.</p>
        <a href="/service-areas/">Explore service areas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="shell cta-card reveal">
      <div>
        <h2 class="section-title">Let’s Talk About Your Home</h2>
      </div>
      <div class="cta-actions">
        <GlassAction href="/contact/" label="Request a Quote" variant="light" client:visible />
        <a href="tel:+19258341815">Call (925) 834-1815</a>
        <span>Monday–Saturday · 9:00 AM–4:00 PM</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 92px 0 110px;
    background: linear-gradient(115deg, #ffffff 0%, #f8fcfd 58%, #e5f4f8 100%);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 90px;
    align-items: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .about-visual {
    position: relative;
    min-height: 650px;
    overflow: hidden;
    border-radius: 36px;
    background: linear-gradient(145deg, #edf8fa 0%, #c6e4eb 50%, #7fb8c9 100%);
    box-shadow: var(--shadow);
  }

  .value-chip {
    position: absolute;
    padding: 12px 18px;
    border-radius: 999px;
    color: var(--sc-note-ink, var(--navy));
    background: var(--sc-note-surface, rgba(255, 255, 255, 0.92));
    box-shadow: 0 12px 30px rgba(17, 33, 46, 0.12);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .value-chip-one { top: 36px; left: 36px; }
  .value-chip-two { top: 42%; right: 28px; }
  .value-chip-three { bottom: 36px; left: 44px; }

  .visual-message {
    position: absolute;
    right: 38px;
    bottom: 90px;
    display: grid;
    max-width: 330px;
    gap: 10px;
    padding: 26px;
    border-radius: 22px;
    background: rgba(20, 70, 120, 0.94);
    box-shadow: 0 18px 45px rgba(17, 33, 46, 0.18);
  }

  .visual-message span {
    color: #9ed3e2;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .visual-message strong {
    color: white;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .about-intro,
  .about-owner,
  .principles,
  .customer-proof,
  .about-services,
  .about-local {
    padding: 112px 0;
  }

  .about-owner {
    padding-top: 0;
  }

  .about-owner a {
    color: var(--navy);
    font-weight: 700;
  }

  .owner-photo {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-top: 32px;
    border-radius: 28px;
    box-shadow: var(--shadow);
  }

  .intro-grid,
  .services-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: 100px;
    align-items: start;
  }

  .intro-copy {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .intro-copy p {
    margin: 0 0 22px;
  }

  .principles {
    background: #f4f9fa;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .principle-card {
    min-height: 390px;
    padding: 34px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--paper);
  }

  .principle-card.featured {
    color: white;
    border-color: var(--navy);
    background: var(--navy);
    box-shadow: 0 24px 55px rgba(20, 70, 120, 0.18);
    transform: translateY(-12px);
  }

  .principle-card > span {
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .principle-card h3 {
    margin: 88px 0 20px;
    font-size: 1.8rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .principle-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .principle-card.featured p {
    color: rgba(255, 255, 255, 0.75);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: 110px;
    align-items: start;
  }

  .proof-intro {
    position: sticky;
    top: 110px;
  }

  .proof-intro > p:last-child {
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .review-stack {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .review-item {
    padding: 36px 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .review-item p {
    margin: 0 0 22px;
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.18;
  }

  .review-item footer {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .approach {
    padding: 112px 0;
    color: white;
    background: var(--ink);
  }

  .section-heading-light .section-title,
  .section-heading-light > p {
    color: white;
  }

  .section-heading-light .eyebrow {
    color: #8cc9dc;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 52px;
  }

  .approach-grid article {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .approach-grid span {
    color: #8cc9dc;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .approach-grid h3 {
    margin: 38px 0 18px;
    font-size: 1.55rem;
    letter-spacing: -0.025em;
  }

  .approach-grid p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
  }

  .service-links {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .service-links a {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 25px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .service-links span {
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .service-links strong {
    font-size: 1.15rem;
  }

  .service-links i {
    color: var(--navy);
    font-style: normal;
    transition: transform 180ms ease;
  }

  .service-links a:hover i {
    transform: translateX(4px);
  }

  .about-local {
    background: var(--pale);
  }

  .local-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
    gap: 80px;
    align-items: center;
  }

  .local-card > div:last-child p {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .local-card a {
    color: var(--navy);
    font-weight: 750;
    text-decoration: none;
  }

  .about-cta {
    padding: 28px 0 112px;
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.55fr);
    gap: 70px;
    align-items: center;
    padding: 68px;
    border-radius: 32px;
    color: white;
    background: var(--navy);
    box-shadow: 0 28px 70px rgba(20, 70, 120, 0.2);
  }

  .cta-card .eyebrow {
    color: #8cc9dc;
  }

  .cta-card .section-title {
    color: white;
  }

  .cta-actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .button-white {
    color: var(--navy);
    background: white;
  }

  .cta-actions > a:not(.button) {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .cta-actions span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
  }

  @media (max-width: 991px) {
    .about-hero-grid,
    .intro-grid,
    .services-grid,
    .proof-grid,
    .local-card {
      grid-template-columns: 1fr;
    }

    .about-hero-grid,
    .proof-grid {
      gap: 62px;
    }

    .about-visual {
      min-height: 560px;
    }

    .principle-grid,
    .approach-grid {
      grid-template-columns: 1fr;
    }

    .principle-card {
      min-height: auto;
    }

    .principle-card.featured {
      transform: none;
    }

    .principle-card h3 {
      margin-top: 48px;
    }

    .proof-intro {
      position: static;
    }

    .cta-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 62px 0 78px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .about-visual {
      min-height: 430px;
      border-radius: 26px;
    }

    .visual-message {
      right: 20px;
      bottom: 72px;
      left: 20px;
      max-width: none;
    }

    .value-chip-one { top: 20px; left: 20px; }
    .value-chip-two { top: 100px; right: 20px; }
    .value-chip-three { display: none; }

    .about-intro,
    .about-owner,
    .principles,
    .customer-proof,
    .approach,
    .about-services,
    .about-local {
      padding: 78px 0;
    }

    .about-owner {
      padding-top: 0;
    }

    .principle-card {
      padding: 28px;
      border-radius: 22px;
    }

    .approach-grid {
      gap: 40px;
    }

    .about-cta {
      padding: 16px 0 78px;
    }

    .cta-card {
      gap: 42px;
      padding: 42px 26px;
      border-radius: 26px;
    }

    .cta-actions,
    .cta-actions .button {
      width: 100%;
    }
  }
</style>
