---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassAction from '../components/liquid-glass/GlassAction';

const areas = [
  {
    name: 'Concord',
    description: 'Sparkclean’s home base and primary service area.',
    href: '/service-areas/concord-ca/',
    featured: true,
  },
  {
    name: 'Pleasant Hill',
    description: 'Recurring, deep, moving, and post-remodel cleaning.',
    href: '/service-areas/pleasant-hill-ca/',
  },
  {
    name: 'Martinez',
    description: 'Residential cleaning for everyday care and home transitions.',
    href: '/service-areas/martinez-ca/',
  },
  {
    name: 'Walnut Creek',
    description: 'Residential service availability confirmed by address.',
    href: '/service-areas/walnut-creek-ca/',
  },
  {
    name: 'Lafayette',
    description: 'Contact Sparkclean to discuss your home and preferred timing.',
    href: '/contact/',
  },
  {
    name: 'Moraga',
    description: 'Residential cleaning appointments based on availability.',
    href: '/contact/',
  },
  {
    name: 'Orinda',
    description: 'Request a quote with your address and service priorities.',
    href: '/contact/',
  },
  {
    name: 'Berkeley',
    description: 'Select residential appointments; contact us to confirm.',
    href: '/contact/',
  },
  {
    name: 'San Francisco',
    description: 'Limited availability; contact Sparkclean before scheduling.',
    href: '/contact/',
  },
];
---

<BaseLayout
  title="House Cleaning Service Areas | Sparkclean Concord, CA"
  description="Sparkclean provides residential cleaning in Concord, Pleasant Hill, Martinez, Walnut Creek, and select East Bay communities. Confirm availability for your address."
>
  <section class="areas-hero">
    <div class="shell areas-hero-grid">
      <div class="reveal">
        <h1 class="display-title">House Cleaning Service Areas</h1>
      </div>
      <div class="hero-copy reveal">
        <p class="lead">Sparkclean serves homes in Concord and nearby communities with recurring, deep, move-in/move-out, and post-construction cleaning.</p>
        <p>Share your address area and preferred timing so we can confirm availability.</p>
        <GlassAction href="/contact/" label="Check Availability" client:load />
      </div>
    </div>
  </section>

  <section class="area-directory">
    <div class="shell">
      <div class="section-heading reveal">
        <div>
          <h2 class="section-title">Find Your Community</h2>
        </div>
        <p>Explore our main service areas below. For other listed cities, select your area to contact us about availability.</p>
      </div>

      <div class="area-grid">
        {areas.map((area) => (
          <a class:list={['area-card', { featured: area.featured }, 'reveal']} href={area.href}>
            <strong>{area.name}</strong>
            <p>{area.description}</p>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="availability">
    <div class="shell availability-grid">
      <div class="availability-visual reveal">
        <div>
          <span>Local availability</span>
          <strong>Let’s check availability for your home.</strong>
        </div>
      </div>

      <div class="availability-copy reveal">
        <h2 class="section-title">Check Availability for Your Address</h2>
        <p>We come to you. Appointment availability depends on your address, the service needed, and our schedule.</p>

        <div class="availability-list">
          <div><span aria-hidden="true">✓</span><p>Your city and address area</p></div>
          <div><span aria-hidden="true">✓</span><p>Home size and cleaning service</p></div>
          <div><span aria-hidden="true">✓</span><p>Your preferred dates or schedule</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="area-services">
    <div class="shell">
      <div class="section-heading section-heading-light reveal">
        <div>
          <h2 class="section-title">Our Cleaning Services</h2>
        </div>
        <p>Choose regular upkeep, a detailed one-time clean, or help with a move or remodel.</p>
      </div>

      <div class="service-grid">
        <a href="/recurring-cleaning-concord-ca/"><strong>Recurring Cleaning</strong><p>Dependable upkeep for everyday living spaces.</p></a>
        <a href="/deep-cleaning-concord-ca/"><strong>Deep Cleaning</strong><p>Extra attention to buildup and overlooked details.</p></a>
        <a href="/move-in-move-out-cleaning-concord-ca/"><strong>Move-In &amp; Move-Out Cleaning</strong><p>Cleaning before or after your move.</p></a>
        <a href="/post-construction-cleaning-concord-ca/"><strong>Post-Construction Cleaning</strong><p>A final clean after residential remodeling.</p></a>
      </div>
    </div>
  </section>

  <section class="areas-cta">
    <div class="shell cta-card reveal">
      <div>
        <h2 class="section-title">Don’t See Your City? Ask Us.</h2>
      </div>
      <div class="cta-actions">
        <GlassAction href="/contact/" label="Request a Quote" variant="light" client:visible />
        <a href="tel:+19258341815">Call (925) 834-1815</a>
        <span>Monday–Saturday · 9:00 AM–4:00 PM</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .areas-hero {
    padding: 110px 0;
    background: linear-gradient(115deg, #ffffff 0%, #f8fcfd 58%, #e5f4f8 100%);
  }

  .areas-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.55fr);
    gap: 100px;
    align-items: end;
  }

  .hero-copy > p:not(.lead) {
    margin: 22px 0 30px;
    color: var(--muted);
    line-height: 1.7;
  }

  .area-directory,
  .availability {
    padding: 112px 0;
  }

  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .area-card {
    display: grid;
    min-height: 260px;
    align-content: end;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .area-card:hover {
    box-shadow: 0 18px 38px rgba(20, 70, 120, 0.1);
    transform: translateY(-3px);
  }

  .area-card.featured {
    color: white;
    border-color: var(--navy);
    background: var(--navy);
  }

  .area-card > span {
    margin-bottom: 48px;
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .area-card strong {
    font-size: 1.65rem;
    letter-spacing: -0.03em;
  }

  .area-card p {
    margin: 10px 0 22px;
    color: var(--muted);
    line-height: 1.55;
  }

  .area-card.featured p {
    color: rgba(255, 255, 255, 0.72);
  }

  .area-card i {
    color: var(--blue);
    font-style: normal;
  }

  .availability {
    background: var(--pale);
  }

  .availability-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 100px;
    align-items: center;
  }

  .availability-visual {
    display: flex;
    min-height: 590px;
    align-items: flex-end;
    padding: 34px;
    border-radius: 32px;
    background: linear-gradient(145deg, #dff1f5 0%, #b9dce6 55%, #8fc4d5 100%);
  }

  .availability-visual > div {
    display: grid;
    width: 100%;
    gap: 9px;
    padding: 27px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 18px 45px rgba(17, 33, 46, 0.12);
  }

  .availability-visual span {
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .availability-visual strong {
    color: var(--navy);
    font-size: 1.7rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .availability-copy > p:not(.eyebrow) {
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .availability-list {
    display: grid;
    margin-top: 42px;
    border-top: 1px solid #c8dce3;
  }

  .availability-list div {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid #c8dce3;
  }

  .availability-list span {
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .availability-list p {
    margin: 0;
  }

  .area-services {
    padding: 112px 0;
    color: white;
    background: var(--ink);
  }

  .section-heading-light .section-title,
  .section-heading-light > p {
    color: white;
  }

  .section-heading-light .eyebrow {
    color: #8cc9dc;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .service-grid a {
    display: grid;
    min-height: 235px;
    align-content: end;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
  }

  .service-grid span {
    margin-bottom: 48px;
    color: #8cc9dc;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .service-grid strong {
    color: white;
    font-size: 1.55rem;
  }

  .service-grid p {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.68);
  }

  .areas-cta {
    padding: 112px 0;
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.55fr);
    gap: 70px;
    align-items: center;
    padding: 68px;
    border-radius: 32px;
    color: white;
    background: var(--navy);
    box-shadow: 0 28px 70px rgba(20, 70, 120, 0.2);
  }

  .cta-card .eyebrow { color: #8cc9dc; }
  .cta-card .section-title { color: white; }

  .cta-actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .button-white {
    color: var(--navy);
    background: white;
  }

  .cta-actions > a:not(.button) {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .cta-actions span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .areas-hero-grid,
    .availability-grid,
    .cta-card {
      grid-template-columns: 1fr;
    }

    .areas-hero-grid,
    .availability-grid {
      gap: 56px;
    }

    .area-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .areas-hero {
      padding: 72px 0 82px;
    }

    .area-directory,
    .availability,
    .area-services,
    .areas-cta {
      padding: 78px 0;
    }

    .area-grid,
    .service-grid {
      grid-template-columns: 1fr;
    }

    .area-card,
    .service-grid a {
      min-height: 220px;
    }

    .availability-visual {
      min-height: 430px;
      padding: 20px;
      border-radius: 26px;
    }

    .cta-card {
      gap: 42px;
      padding: 42px 26px;
      border-radius: 26px;
    }

    .cta-actions,
    .cta-actions .button {
      width: 100%;
    }
  }
</style>
