---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { instagramUrl, areaServedSchema, foundingYear } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const isNotFound = /\/404(?:\.html)?\/?$/.test(Astro.url.pathname);
const canonicalUrl = isNotFound
  ? undefined
  : canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const sitemapUrl = Astro.site ? new URL('/sitemap-index.xml', Astro.site).href : undefined;
// Until the production domain is set at build time, every page asks search engines not to index it.
const isPreviewBuild = !Astro.site;
// Share previews need an absolute URL; the workers.dev address is used until the domain is set.
const shareImage = new URL('/images/sparkclean-logo.png', Astro.site ?? 'https://sparkclean-website.gabe-tony-lr.workers.dev').href;
// Cloudflare Web Analytics (cookieless). Set PUBLIC_CF_BEACON_TOKEN in the build to turn it on.
const analyticsToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN?.trim();

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Sparkclean Cleaning Services',
  description,
  telephone: '+1-925-834-1815',
  email: 'companysparkclean@gmail.com',
  foundingDate: String(foundingYear),
  areaServed: areaServedSchema,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '09:00',
      closes: '16:00',
    },
  ],
  ...(instagramUrl ? { sameAs: [instagramUrl] } : {}),
  ...(Astro.site ? {
    '@id': new URL('/#business', Astro.site).href,
    url: Astro.site.href,
    logo: new URL('/images/sparkclean-logo.png', Astro.site).href,
  } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#144678" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sparkclean Cleaning Services" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Sparkclean Cleaning Services logo" />
    <meta name="twitter:card" content="summary" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {sitemapUrl && <link rel="sitemap" type="application/xml" href={sitemapUrl} />}
    {(isNotFound || isPreviewBuild) && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}

    <script>
      const revealItems = document.querySelectorAll('.reveal');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.14 },
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1000;
    padding: 12px 16px;
    color: #ffffff;
    background: #11212e;
    border-radius: 10px;
    transform: translateY(-160%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
